{
  "name": "game-bot",
  "version": "0.0.3",
  "description": "A tool for Shadowrun GMs",
  "main": "main.js",
  "author": "Nathan Hawks",
  "private": true,
  "engines": {
    "node": ">=24.17.0 <25",
    "npm": "11.x"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "start": "node main.js",
    "check": "node scripts/check-syntax.js",
    "test": "node --test \"test/*.test.js\"",
    "crypto:rotate": "node scripts/rotate-encryption-key.js",
    "crypto:keys": "node scripts/rotate-encryption-key.js --generate-keys",
    "test:rotation-mongo": "node scripts/test-key-rotation-mongo.js"
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "mongodb": "^4.17.2",
    "node-stream-zip": "^1.15.0"
  }
}
